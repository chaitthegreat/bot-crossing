 server/discovery.mjs | 13 ++++++++++++-
 server/guest.mjs     | 34 +++++++++++++++++++++++++++++++---
 src/game/colony.js   | 23 +++++++++++++++++------
 src/main.js          |  5 +++++
 src/ui/hud.js        | 41 +++++++++++++++++++++++++++++++++++------
 src/ui/styles.css    | 33 +++++++++++++++++++++++++++++++++
