+      const fz = Math.cos(d.heading)
+      const forwardV = d.vx * fx + d.vz * fz
+      const forwardA = dt > 0 ? (ax * fx + az * fz) / dt : 0
+      const sideV = d.vx * fz - d.vz * fx
+      const sideA = dt > 0 ? (ax * fz - az * fx) / dt : 0
