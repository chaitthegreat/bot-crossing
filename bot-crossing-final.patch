+      levels[conn.portIndex] = Math.max(levels[conn.portIndex], Math.max(0, conn.hold))
+    }
+  }
+
+  _remove(agentId) {
+    const conn = this.connections.get(agentId)
+    if (!conn) return
+    this.scene.remove(conn.mesh)
+    conn.mesh.geometry.dispose()
+    conn.material.dispose()
