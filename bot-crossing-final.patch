+  const idles = many(50, 'idle')
+  const crew = capRoster([...idles, ...many(5, 'working')], 30)
+  const kept = crew.filter((e) => e.status === 'idle')
+  assert.deepEqual(ids(kept), ids(idles).slice(0, kept.length))
+})
+
