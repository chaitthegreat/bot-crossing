+#include <beginnormal_vertex>
+if ( aWing != 0.0 ) objectNormal = bcWingSpin( objectNormal, vec3( 0.0 ), bcFlap() * aWing );
+#ifdef BC_DRONE
+if ( aSpin != 0.0 ) objectNormal = bcSpinY( objectNormal, vec3( 0.0 ), aRotor * aSpin );
+#endif
+`
