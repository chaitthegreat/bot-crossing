Subject: [PATCH 48/54] Blocked astronauts wear the error face

The status is 'blocked' but the face loop was filed under 'broken', so a
blocked astronaut kept the idle face under its alarm badge.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/agents/faces.js | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/agents/faces.js b/src/agents/faces.js
index 6cb1327..dad7527 100644
--- a/src/agents/faces.js
+++ b/src/agents/faces.js
@@ -42,6 +42,9 @@ export const FACE_LOOPS = {
   celebrating: [FACE.cheer, FACE.happy, FACE.cheer, FACE.love],
   waiting: [FACE.wait, FACE.wait, FACE.alert, FACE.wait],
   broken: [FACE.error, FACE.error, FACE.sad, FACE.error],
+  // The status is called `blocked`; the loop was only ever filed under `broken`, so a
+  // blocked astronaut wore the idle face.
+  blocked: [FACE.error, FACE.error, FACE.sad, FACE.error],
   sleeping: [FACE.sleep],
 }
 
