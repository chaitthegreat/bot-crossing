-  opacity: 0;
-  transform: scale(0.985);
+/* Hiding the UI fades every panel except the thread card: clicking an astronaut is still
+   how you ask what they are doing, so their card stays, on its own, beside them. */
+.hud.hidden > :not(.thread-pop) {
+  opacity: 0 !important;
   pointer-events: none !important;
 }
 
-.hud.hidden * {
+.hud.hidden > :not(.thread-pop) * {
   pointer-events: none !important;
 }
 
+/* Zero-specificity, so a panel with a transition of its own keeps it (and adds opacity). */
+.hud > :where(:not(.thread-pop)) {
+  transition: opacity 220ms ease;
+}
