+    tag(body),
+    tag(head),
+    tag(beak, { aAccent: 1 }),
+    tag(right, { aWing: 1, pivot: [0.1, 0.05, 0] }),
+    tag(left, { aWing: -1, pivot: [-0.1, 0.05, 0] }),
+    tag(tail),
