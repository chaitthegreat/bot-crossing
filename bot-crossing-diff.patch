+      const material = new THREE.MeshBasicMaterial({ color: PORT_IDLE, toneMapped: true })
+      const socket = new THREE.Mesh(new THREE.SphereGeometry(0.26, 12, 10), material)
+      socket.position.set(x, 1.05, z)
