+  body.scale(1, 1, 3.4)
+  const right = wingQuad(0.065, 0.09, 0.055, 0.008, 1)
+  right.translate(0.006, 0.004, 0)
+  const left = wingQuad(0.065, 0.09, 0.055, 0.008, -1)
