+  const hull = new RoundedBoxGeometry(0.5, 0.2, 0.5, 3, 0.07)
+  parts.push(tag(hull))
+  const canopy = new THREE.SphereGeometry(0.12, 8, 6)
+  canopy.scale(1, 0.6, 1)
+  canopy.translate(0, 0.1, 0.02)
