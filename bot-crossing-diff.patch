+    tag(body, { aAccent: 1 }),
+    tag(right, { aWing: 1, pivot: [0, 0.004, 0] }),
+    tag(left, { aWing: -1, pivot: [0, 0.004, 0] }),
+  ])
+}
+
+/** A plump body, a tail fin that wags and a dorsal fin, about 0.45 long. */
