+          break
+        }
+        case 'cruise':
+        case 'return': {
+          const gx = d.state === 'cruise' ? d.tx : d.homeX
+          const gz = d.state === 'cruise' ? d.tz : d.homeZ
+          const dx = gx - d.x
+          const dz = gz - d.z
+          const dist = Math.hypot(dx, dz)
+          wantY = this._cruiseY(d.x, d.z)
+          if (dist < 0.4) {
